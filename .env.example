# ── 站点配置 ──────────────────────────────────────────
# 站点基础 URL：部署到 Vercel 后，在 Project Settings → Environment Variables
# 设置为真实域名（如 https://www.worldflavors.com），无需改代码。
# 本地开发可不设置（自动回退到占位域名）。
NEXT_PUBLIC_SITE_URL=https://worldflavors.example.com

# ── 阶段②·支付系统预留（接入时填写）─────────────────────
# DATABASE_URL=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
