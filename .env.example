# ── 站点配置（阶段④·部署，当前需要）────────────────────
# 站点基础 URL：部署到 Vercel 后在 Project Settings → Environment Variables 设置
# 本地开发可不设置（自动回退到占位域名 worldflavors.example.com）
NEXT_PUBLIC_SITE_URL=https://worldflavors.example.com

# ── 阶段②·用户认证：Clerk（当前需要）────────────────────
# 去 https://dashboard.clerk.com 免费创建应用 → API Keys 页复制
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup

# ── 数据库（TODO(backend) 预留，订单/会员数据落库时启用）──
# DATABASE_URL=postgresql://user:password@host:5432/worldflavors

# ── 阶段②·支付：Stripe（TODO(payment) 预留）─────────────
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ── 阶段②·支付：PayPal（TODO(payment) 预留）──────────────
